{
  "color": {
    "$type": "color",
    "surface": {
      "base": {
        "$value": "{palette.paper.50}"
      },
      "sunken": {
        "$value": "{palette.paper.100}"
      },
      "raised": {
        "$value": "{palette.paper.0}"
      },
      "overlay": {
        "$value": "{palette.paper.0}"
      },
      "hover": {
        "$value": "{palette.paper.100}"
      },
      "selected": {
        "$value": "{palette.amber.100}"
      }
    },
    "text": {
      "default": {
        "$value": "{palette.paper.900}"
      },
      "muted": {
        "$value": "{palette.paper.600}"
      },
      "disabled": {
        "$value": "{palette.paper.400}"
      },
      "accent": {
        "$value": "{palette.amber.700}"
      },
      "link": {
        "$value": "{palette.amber.700}"
      },
      "onAccent": {
        "$value": "{palette.paper.950}"
      }
    },
    "border": {
      "subtle": {
        "$value": "{palette.paper.200}"
      },
      "default": {
        "$value": "{palette.paper.500}"
      },
      "strong": {
        "$value": "{palette.paper.600}"
      },
      "focus": {
        "$value": "{palette.amber.600}"
      }
    },
    "accent": {
      "default": {
        "$value": "{palette.amber.400}"
      },
      "hover": {
        "$value": "{palette.amber.300}"
      },
      "subtle": {
        "$value": "{palette.amber.100}"
      }
    },
    "status": {
      "danger": {
        "text": {
          "$value": "{palette.rust.500}"
        },
        "surface": {
          "$value": "{palette.paper.100}"
        }
      },
      "success": {
        "text": {
          "$value": "{palette.moss.500}"
        },
        "surface": {
          "$value": "{palette.paper.100}"
        }
      },
      "warning": {
        "text": {
          "$value": "{palette.amber.700}"
        },
        "surface": {
          "$value": "{palette.amber.50}"
        }
      }
    },
    "unread": {
      "indicator": {
        "$value": "{palette.amber.600}"
      }
    },
    "motif": {
      "gossamer": {
        "$value": "{palette.paper.300}"
      }
    },
    "media": {
      "scrim": {
        "$value": "{palette.scrim}"
      },
      "caption": {
        "$value": "{palette.paper.0}"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": {
        "color": "#211C1614",
        "offsetX": "0px",
        "offsetY": "1px",
        "blur": "3px",
        "spread": "0px"
      }
    },
    "overlay": {
      "$value": {
        "color": "#211C1629",
        "offsetX": "0px",
        "offsetY": "12px",
        "blur": "32px",
        "spread": "-8px"
      }
    }
  }
}
