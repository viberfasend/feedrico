{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Feedrico",
  "version": "0.1.0",
  "identifier": "de.andi1984.feedrico",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Feedrico",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' media: http://media.localhost data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "News",
    "shortDescription": "Fast, local-only RSS reader",
    "longDescription": "Feedrico keeps all your Feeds, Articles and reading state in one portable Library folder. No account, no sync service, no telemetry.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
