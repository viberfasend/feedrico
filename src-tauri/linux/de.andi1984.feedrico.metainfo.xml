  <releases>
    <release version="0.2.0" date="2026-11-13"/>
    <release version="0.1.0" date="2026-11-13"/>
  </releases>
  <launchable type="desktop-id">Feedrico.desktop</launchable>
  <icon type="stock">feedrico</icon>
  <url type="homepage">https://viberfasend.github.io/feedrico/</url>
  <url type="bugtracker">https://github.com/viberfasend/feedrico/issues</url>
  <categories>
    <category>Network</category>
    <category>News</category>
  </categories>
  <provides>
    <binary>feedrico</binary>
  </provides>
  <content_rating type="oars-1.1"/>
