<!-- AppStream metadata: what Ubuntu's App Center and GNOME Software show for the .deb
     (name, summary, icon, licence). `node scripts/release.mjs version` adds the release entry. -->
<component type="desktop-application">
  <id>de.andi1984.feedrico</id>
  <name>Feedrico</name>
  <summary>Fast, local-only RSS reader</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="de.andi1984">
    <name>Feedrico contributors</name>
  </developer>
  <description>
    <p>Feedrico keeps all your feeds, articles and reading state in one portable Library folder. No account, no sync service, no telemetry.</p>
