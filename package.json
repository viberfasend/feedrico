{
  "name": "feedrico",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "dev": "npm run tokens && vite",
    "build": "npm run tokens && vite build",
    "preview": "vite preview",
    "site:build": "npm run tokens && node scripts/build-site.mjs",
    "site:preview": "node scripts/serve-site.mjs",
    "check": "npm run tokens && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "npm run tokens && vitest run",
    "test:coverage": "npm run tokens && vitest run --coverage",
    "tauri": "tauri",
    "perf": "node scripts/perf.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "commitlint": "commitlint"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.8",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.0",
    "happy-dom": "^21.0.4",
    "style-dictionary": "^5.8.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "bits-ui": "^2.20.6"
  }
}
